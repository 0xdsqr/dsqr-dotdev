{
  "name": "dsqr-dotdev",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "npm run dev --workspace dotdev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "db:push": "npm run push --workspace @dsqr-dotdev/database --",
    "db:studio": "npm run studio --workspace @dsqr-dotdev/database --",
    "db:generate": "npm run generate --workspace @dsqr-dotdev/database --",
    "db:migrate": "npm run migrate --workspace @dsqr-dotdev/database --"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "browserslist": ["chrome >= 123", "edge >= 123", "firefox >= 120", "safari >= 17.5", "ios_saf >= 17.5"]
}
