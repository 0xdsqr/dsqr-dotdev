{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["application", "image", "imagePullSecrets", "replicaCount", "resources", "trustProxy", "trustedOrigins", "database", "route"],
  "properties": {
    "application": {"enum": ["dotdev", "labs", "studio"]},
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "imagePullSecrets": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name"],
        "properties": {"name": {"$ref": "#/definitions/name"}}
      }
    },
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 6},
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/definitions/resources"},
        "limits": {"$ref": "#/definitions/resources"}
      }
    },
    "trustProxy": {"type": "boolean"},
    "trustedOrigins": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]{1,5})?$"}
    },
    "database": {
      "type": "object", "additionalProperties": false,
      "required": ["existingSecret", "caConfigMap", "address", "port"],
      "properties": {
        "existingSecret": {"anyOf": [{"const": ""}, {"$ref": "#/definitions/name"}]},
        "caConfigMap": {"anyOf": [{"const": ""}, {"$ref": "#/definitions/name"}]},
        "address": {"anyOf": [{"const": ""}, {"type": "string", "format": "ipv4"}]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "route": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "hostnames"],
      "properties": {
        "enabled": {"type": "boolean"},
        "hostnames": {
          "type": "array", "uniqueItems": true, "maxItems": 16,
          "items": {"$ref": "#/definitions/name"}
        }
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {"hostnames": {"minItems": 1}}}
    }
  },
  "allOf": [{
    "if": {"properties": {"application": {"const": "dotdev"}}},
    "then": {
      "properties": {
        "replicaCount": {"const": 1},
        "database": {"properties": {
          "existingSecret": {"$ref": "#/definitions/name"},
          "caConfigMap": {"$ref": "#/definitions/name"},
          "address": {"type": "string", "format": "ipv4", "minLength": 7}
        }}
      }
    }
  }],
  "definitions": {
    "name": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": "string", "pattern": "^[1-9][0-9]*m?$"},
        "memory": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"}
      }
    }
  }
}
