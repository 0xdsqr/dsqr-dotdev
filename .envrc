# Nix owns the development toolchain; direnv activates it automatically.
if has nix; then
  watch_file flake.nix
  watch_file flake.lock
  watch_file nix/devshell.nix
  watch_file nix/database.nix
  watch_file nix/checks/database.nix
  watch_file nix/checks.nix
  watch_file nix/checks/app.nix
  watch_file nix/packages/default.nix
  watch_file nix/packages/app.nix
  watch_file nix/packages/image.nix
  use flake
fi

watch_file .envrc.local
if [[ -f .envrc.local ]]; then
  set -a
  source .envrc.local
  set +a
fi
