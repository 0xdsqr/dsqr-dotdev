{
  "name": "@dsqr-dotdev/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": "./src/schema.ts",
    "./server": "./src/database.server.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "push": "drizzle-kit push --config drizzle.config.ts",
    "studio": "drizzle-kit studio --config drizzle.config.ts --host 127.0.0.1",
    "generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrate": "drizzle-kit migrate --config drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "effect": "4.0.0-beta.107",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
